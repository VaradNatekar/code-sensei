{
    "compilerOptions": {
        "module": "Node16",
        "target": "ES2022",

        "lib": [
            "ES2022",
            "DOM"
        ],

        "types": [
            "node",
            "mocha"
        ],

        "moduleResolution": "node16",

        "sourceMap": true,
        "rootDir": "src",

        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true
    },

    "exclude": [
        "demo",
        "code-sensei",
        "node_modules",
        "dist"
    ]
}